# RouterAI (https://routerai.ru)
ROUTERAI_API_KEY=your_routerai_api_key_here
ROUTERAI_BASE_URL=https://routerai.ru/api/v1

# Model (confirm exact slug in your RouterAI dashboard)
MODEL_ID=x-ai/grok-4.20

# Versions
PROMPT_VERSION=v1.0.0
SCHEMA_VERSION=v1.0.0

# Behaviour
MAX_RETRIES=1
REQUEST_TIMEOUT=60.0
TEMPERATURE=0.2

# Paths
LOG_DIR=logs
REPORTS_DIR=reports

# Optional: for local testing without real API calls
# MOCK_LLM=false
